{
  "name": "app-store-moderation-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Interview boilerplate: a Fanvue App Store listing moderation tool (Next.js 15, @fanvue/ui, fixtures-backed mock of the public /v0/apps API)",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "vitest run acceptance",
    "test:smoke": "vitest run --exclude \"**/*.acceptance.test.*\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fanvue/ui": "^3.31.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "motion",
        "react-day-picker",
        "recharts"
      ]
    },
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
