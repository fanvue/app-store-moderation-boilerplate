{
  "name": "app-store-moderation-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Interview boilerplate: a Fanvue App Store listing moderation tool (Next.js 15, @fanvue/ui, fixtures-backed mock of the public /v0/apps API)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n db,web -c blue,green \"npm:db\" \"next dev --turbopack -p 3000\"",
    "db": "node scripts/db.mjs",
    "db:query": "tsx --tsconfig tsconfig.json scripts/db-query.ts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/db-migrate.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('data', { recursive: true, force: true }); console.log('data/ removed; the next npm run dev starts from an empty database')\"",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest --exclude \"**/spec.test.*\"",
    "test:spec": "vitest run spec",
    "test:smoke": "vitest run --exclude \"**/spec.test.*\"",
    "see-all-rule-counts": "tsx --tsconfig tsconfig.json scripts/see-all-rule-counts.ts",
    "review": "tsx --tsconfig tsconfig.json scripts/review.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fanvue/ui": "^3.31.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "next": "^15.5.25",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
