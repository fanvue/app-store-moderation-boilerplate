{
  "name": "app-store-moderation-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interview boilerplate: a Fanvue App Store listing moderation tool (Next.js 15, @fanvue/ui, fixtures-backed mock of the public /v0/apps API and its webhook)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n db,web,worker -c blue,green,magenta \"npm:db\" \"next dev --turbopack -p 3000\" \"npm:worker\"",
    "worker": "tsx watch --clear-screen=false --tsconfig tsconfig.json scripts/worker.ts",
    "send-events": "tsx --tsconfig tsconfig.json scripts/send-events.ts",
    "measure": "tsx --tsconfig tsconfig.json scripts/measure.ts",
    "db": "node scripts/db.mjs",
    "db:query": "tsx --tsconfig tsconfig.json scripts/db-query.ts",
    "db:migrate": "tsx --tsconfig tsconfig.json scripts/db-migrate.ts",
    "db:reset": "node -e \"require('node:fs').rmSync('data', { recursive: true, force: true }); console.log('data/ removed; the next npm run dev starts from an empty database and an unedited mock API')\"",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fanvue/ui": "^3.31.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "kysely": "0.29.7",
    "next": "^15.5.25",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "concurrently": "10.0.6",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.1.11",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
